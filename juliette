<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pour Juliette ❤️</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    overflow: hidden;
    background: linear-gradient(135deg, #ffd6e7, #fff0f5);
    color: #333;
}

.screen {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 25px;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.5s ease;
    z-index: 2;
}

.screen.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
}

h1 {
    font-size: clamp(2rem, 7vw, 3rem);
    margin: 0 0 20px;
}

p {
    max-width: 700px;
    font-size: clamp(1rem, 4vw, 1.2rem);
    line-height: 1.5;
}

.buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px;
    max-width: 750px;
}

button {
    margin: 8px;
    padding: 14px 25px;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    font-size: 1.05rem;
    transition: transform 0.2s ease;
}

.mainBtn {
    background: #ff4f8b;
    color: white;
}

.altBtn {
    background: #ff8fba;
    color: white;
}

.noBtn {
    background: white;
    color: #333;
}

.heart {
    position: fixed;
    top: -60px;
    color: #ff5b97;
    animation: fall linear infinite;
    z-index: 1;
    pointer-events: none;
    user-select: none;
}

@keyframes fall {
    from {
        transform: translateY(-80px) rotate(0deg);
    }

    to {
        transform: translateY(110vh) rotate(360deg);
    }
}

.movingNo {
    z-index: 10;
}
</style>
</head>

<body>

<div id="hearts"></div>


<!-- PAGE 1 -->

<div id="page1" class="screen">

    <h1>Pour Juliette 🌹</h1>

    <p>
        De la part d'Ilyes ❤️
    </p>

    <button class="mainBtn" onclick="next(1,2)">
        Ouvrir ✨
    </button>

</div>


