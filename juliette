        avec toi. 🌹
        <br><br>

        Alors...
        <br><br>

        À partir de maintenant,
        <br>
        on écrit notre histoire ensemble. ❤️
        <br><br>

        ✨ Fin... ou plutôt le début. ✨
    </p>

</div>


<script>

/* =====================================================
   GOOGLE SHEETS
   ===================================================== */

const GOOGLE_SCRIPT_URL =
"https://script.google.com/macros/s/AKfycbyFRrDZkqEY22DqRXJEqJBTuk6XsZZDa0ERhW4Jdu1M4JuKr5HivUQSsdwsRrPMb6KxGg/exec";


function saveAnswer(question, answerText) {

    fetch(GOOGLE_SCRIPT_URL, {

        method: "POST",

        mode: "no-cors",

        headers: {
            "Content-Type": "text/plain;charset=utf-8"
        },

        body: JSON.stringify({
            question: question,
            answer: answerText
        })

    }).catch(function(error) {

        console.log("Erreur d'envoi :", error);

    });

}


function answer(current, nextPage, question, response) {

    saveAnswer(question, response);

    next(current, nextPage);

}


/* =====================================================
   CHANGEMENT DE PAGE
   ===================================================== */

function next(a, b) {

    const current =
        document.getElementById("page" + a);

    const target =
        document.getElementById("page" + b);

    if (current && target) {

        current.classList.add("hidden");

        target.classList.remove("hidden");

    }

}


/* =====================================================
   CŒURS
   ===================================================== */

for (let i = 0; i < 30; i++) {

    const h = document.createElement("div");

    h.className = "heart";

    h.textContent = "❤️";

    h.style.left =
        Math.random() * 100 + "vw";

    h.style.animationDuration =
        (5 + Math.random() * 8) + "s";

    h.style.animationDelay =
        (-Math.random() * 10) + "s";

    h.style.fontSize =
        (15 + Math.random() * 25) + "px";

    document
        .getElementById("hearts")
        .appendChild(h);
}


/* =====================================================
   BOUTONS NON QUI S'ENFUIENT
   ===================================================== */

const movingButtons =
    document.querySelectorAll(".movingNo");


function moveButton(button) {

    button.style.position = "fixed";

    const maxX =
        Math.max(10, window.innerWidth - button.offsetWidth - 10);

    const maxY =
        Math.max(10, window.innerHeight - button.offsetHeight - 10);

    const x =
        10 + Math.random() * Math.max(1, maxX - 10);

    const y =
        10 + Math.random() * Math.max(1, maxY - 10);

    button.style.left = x + "px";

    button.style.top = y + "px";

}


/* Ordinateur */

movingButtons.forEach(function(button) {

    button.addEventListener(
        "mouseenter",
        function() {
            moveButton(button);
        }
    );

    button.addEventListener(
        "click",
        function(event) {

            event.preventDefault();

            moveButton(button);

        }
    );

});


/* Téléphone */

movingButtons.forEach(function(button) {

    button.addEventListener(
        "touchstart",
        function(event) {

            event.preventDefault();

            moveButton(button);

        },
        { passive: false }
    );

});


/* =====================================================
   BOUTON OUI FINAL
   ===================================================== */

const yesBtn =
    document.getElementById("yesBtn");


yesBtn.addEventListener(
    "click",
    function() {

        saveAnswer(
            "Est-ce que tu accepterais de sortir avec moi ?",
            "Oui 💖"
        );

        document
            .getElementById("page10")
            .classList.add("hidden");

        document
            .getElementById("page11")
            .classList.remove("hidden");

    }
);

</script>

</body>
